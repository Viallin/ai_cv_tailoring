# Copy to .env and fill in real values. .env is gitignored.

# LLM provider
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Retry transient provider errors (503/429/timeouts) before giving up.
# This is NOT provider fallback (Gemini -> OpenAI) — see development_plan.md Phase 9.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# Paths
PROMPTS_DIR=prompts
DATA_DIR=data

# Storage (Phase 13 — SQLite, single-user/local; see docs/technology_stack.md)
# Defaults to sqlite:///<DATA_DIR>/cvai.db if unset.
DATABASE_URL=

# Logging
LOG_LEVEL=INFO
